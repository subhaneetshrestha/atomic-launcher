<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility (target 30+): LauncherApps filters by what the caller may see.
        One MAIN/LAUNCHER query exposes every launchable activity; QUERY_ALL_PACKAGES is
        deliberately not declared and must never be added (CI gate).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Uninstall through the system dialog from the app menu (normal permission). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Fetching a background from a collection the user configured. Both are normal permissions,
        nothing is uploaded, and no request is made at all until a collection address is entered.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Opening the notification shade where Android still lets an app do it. A normal permission,
        granted at install; where the platform refuses, the optional accessibility service does it
        instead, and only if the user turns that on.
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!--
        Screen time. Declaring this is what puts atomic in Android's Usage Access list; it grants
        nothing on its own, and the launcher reads nothing until the user turns it on there.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".AtomicApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atomic"
        tools:targetApi="tiramisu">

        <!--
            Home activity attributes follow AOSP Launcher3 plus Olauncher's excludeFromRecents:
            singleTask + taskAffinity="" keep one instance that receives the Home key via
            onNewIntent(); stateNotNeeded makes recreation cheap (all state is persisted);
            resumeWhilePausing lets Home resume before the previous app finishes pausing;
            the configChanges list relayouts on rotation instead of recreating, while locale,
            font scale and night mode still recreate so labels, sizes and colors are re-read.
        -->
        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".setup.SetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!--
            A theme that arrived from somewhere else. Exported because that is the whole point:
            a file manager, a share sheet or a link opens it. It applies nothing on arrival — it
            shows what the theme is and waits to be told.
        -->
        <activity
            android:name=".share.ImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/import_title">
            <intent-filter android:label="@string/import_title">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter android:label="@string/import_title">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!--
                A file manager that knows nothing about the type still knows the name. This is not
                an app link and has no host to name: a file: URI has an empty authority, so lint's
                demand for one would stop the filter matching anything at all.
            -->
            <intent-filter
                android:label="@string/import_title"
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".atomictheme" />
            </intent-filter>
            <intent-filter android:label="@string/import_title">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- atomic://theme?d=<the theme itself> or ?url=<where to fetch it from> -->
            <intent-filter android:label="@string/import_title">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="theme"
                    android:scheme="atomic" />
            </intent-filter>
        </activity>

        <!--
            The only thing the launcher ever hands to another app: a theme it wrote to share.
            Not exported; a share sheet reaches it through the grant on the intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            The six actions Android reserves for an accessibility service. Exported because the
            system binds it, and guarded by BIND_ACCESSIBILITY_SERVICE so only the system can. It
            asks for no events and no window content, and lives in its own process so that a fault
            in it cannot take the home screen down: a home app that dies loses its default status.
        -->
        <service
            android:name=".system.SystemActionsService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":system">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Device administrator, for force-lock and nothing else. The alternative to the
            accessibility service for locking the screen, and the only way to do it on Android 8.
        -->
        <receiver
            android:name=".system.LockAdminReceiver"
            android:description="@string/grant_admin_explanation"
            android:exported="true"
            android:label="@string/grant_admin_title"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            The scheduled turn of the background. Exported because JobScheduler starts it, and
            guarded by BIND_JOB_SERVICE so only the system can.
        -->
        <service
            android:name=".background.BackgroundJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Notification badges. Exported because the system binds it, and guarded by the
            BIND_NOTIFICATION_LISTENER_SERVICE permission so only the system can. It does nothing
            until the user grants notification access in Settings, and asks to be unbound while
            the badge setting is off.
        -->
        <service
            android:name=".notifications.BadgeNotificationListener"
            android:exported="true"
            android:label="@string/badges_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
