<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility (target 30+): LauncherApps filters by what the caller may see.
        One MAIN/LAUNCHER query exposes every launchable activity; QUERY_ALL_PACKAGES is
        deliberately not declared and must never be added (CI gate).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Uninstall through the system dialog from the app menu (normal permission). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".AtomicApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atomic"
        tools:targetApi="tiramisu">

        <!--
            Home activity attributes follow AOSP Launcher3 plus Olauncher's excludeFromRecents:
            singleTask + taskAffinity="" keep one instance that receives the Home key via
            onNewIntent(); stateNotNeeded makes recreation cheap (all state is persisted);
            resumeWhilePausing lets Home resume before the previous app finishes pausing;
            the configChanges list relayouts on rotation instead of recreating, while locale,
            font scale and night mode still recreate so labels, sizes and colors are re-read.
        -->
        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".setup.SetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!--
            Notification badges. Exported because the system binds it, and guarded by the
            BIND_NOTIFICATION_LISTENER_SERVICE permission so only the system can. It does nothing
            until the user grants notification access in Settings, and asks to be unbound while
            the badge setting is off.
        -->
        <service
            android:name=".notifications.BadgeNotificationListener"
            android:exported="true"
            android:label="@string/badges_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
