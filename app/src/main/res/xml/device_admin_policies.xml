<?xml version="1.0" encoding="utf-8"?>
<!--
    One power and no others. force-lock is what lets a gesture lock the screen, and it is the only
    thing an app may do that with below Android 9.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
