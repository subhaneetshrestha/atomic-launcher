    <!-- Android 13 and later: the switch does nothing until restricted settings are allowed -->
    <string name="restricted_title">If the switch does nothing</string>
    <string name="restricted_why">Android blocks notification access for apps installed from a file rather than from a store. The switch is there, but tapping it does nothing until you allow it.</string>
    <string name="restricted_why_maybe">Android blocks notification access for some apps installed outside a store. If the switch did nothing when you tapped it, this is why.</string>
    <string name="restricted_steps">1. Open App info for atomic.\n2. Tap the three dots in the top corner.\n3. Tap \u201cAllow restricted settings\u201d.\n4. Come back and try the switch again.</string>
    <string name="restricted_open">Open App info</string>
    <string name="restricted_try_again">Try the switch again</string>
