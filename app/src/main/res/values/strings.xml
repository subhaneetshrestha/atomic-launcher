    <!-- Notification access: the disclosure shown before Settings is opened -->
    <string name="grant_notification_title">Notification access</string>
    <string name="grant_notification_what">To count what is waiting for each app, atomic needs Android\u2019s notification access. Android asks for this in Settings; the next screen is Settings, not atomic.</string>
    <string name="grant_notification_why">atomic reads which app posted a notification, how many that app has, and whether Android allows a badge for it. It checks whether a notification has any text at all, so that an empty placeholder is not counted, and never reads what that text says.</string>
    <string name="grant_notification_limits">Nothing is written down and nothing leaves your phone. The counts are held while atomic is running and are gone when it stops. You can turn badges off for any app, and you can take this access away in Settings whenever you like.</string>
