{
  "schema": 1,
  "minAppVersion": 1,
  "meta": {
    "id": "you",
    "name": "You",
    "author": "atomic",
    "license": "CC0-1.0",
    "description": "Material You colours from your wallpaper (Android 12+)."
  },
  "colors": {
    "background": "@android:color/system_neutral1_900",
    "text": "@android:color/system_neutral1_50",
    "textSecondary": "@android:color/system_neutral1_200",
    "accent": "@android:color/system_accent1_200"
  },
  "typography": {
    "family": "sans-serif",
    "weight": 400,
    "italic": false,
    "sizes": {
      "homeSp": 24.0,
      "drawerSp": 20.0,
      "clockSp": 48.0,
      "infoSp": 14.0
    }
  },
  "layout": {
    "hAlign": "center",
    "vAlign": "center",
    "paddingDp": {
      "h": 28,
      "v": 24
    },
    "rowGapDp": 4
  },
  "badge": {
    "style": "circle",
    "position": "end",
    "scale": 0.62,
    "background": "@android:color/system_accent1_200",
    "text": "@android:color/system_neutral1_900"
  }
}
