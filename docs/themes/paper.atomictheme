{
  "schema": 1,
  "minAppVersion": 1,
  "meta": {
    "id": "paper",
    "name": "Paper",
    "author": "atomic",
    "license": "CC0-1.0",
    "description": "Dark serif on warm paper; inverts at night."
  },
  "colors": {
    "background": "#FFF6F1E7",
    "text": "#FF1B1B1B",
    "textSecondary": "#B31B1B1B",
    "accent": "#FF1B1B1B"
  },
  "darkColors": {
    "background": "#FF141210",
    "text": "#FFEDE7DA",
    "textSecondary": "#99EDE7DA",
    "accent": "#FFEDE7DA"
  },
  "typography": {
    "family": "serif",
    "weight": 400,
    "italic": false,
    "sizes": {
      "homeSp": 24.0,
      "drawerSp": 20.0,
      "clockSp": 48.0,
      "infoSp": 14.0
    }
  },
  "layout": {
    "hAlign": "start",
    "vAlign": "bottom",
    "paddingDp": {
      "h": 28,
      "v": 56
    },
    "rowGapDp": 6
  },
  "badge": {
    "style": "circle",
    "position": "end",
    "scale": 0.62,
    "background": "auto",
    "text": "auto"
  },
  "background": {
    "mode": "color",
    "gradient": {
      "from": "#FF101820",
      "to": "#FF000000",
      "angle": 0
    },
    "collection": {
      "url": "",
      "intervalMinutes": 360,
      "unmeteredOnly": true,
      "shuffle": true
    },
    "dim": 0.35,
    "autoTextColor": true
  }
}
